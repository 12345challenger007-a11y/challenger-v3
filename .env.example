# Supabase (public keys used by client)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role (server-only, never commit to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI provider (server-only)
AI_API_KEY=your-ai-api-key
AI_API_PROVIDER=openai

# YouTube Data API (server-side)
YOUTUBE_API_KEY=your-youtube-api-key

# NEXT
NEXT_PUBLIC_APP_NAME=CHALLENGER
NEXTAUTH_URL=http://localhost:3000

# Other (optional)
NEXT_PUBLIC_DEFAULT_AVATAR_URL=/default-avatar.png
